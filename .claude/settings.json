{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${CLAUDE_PROJECT_DIR}/scripts/post-edit-diagnostics.ps1"],
            "timeout": 45
          }
        ]
      }
    ]
  }
}
